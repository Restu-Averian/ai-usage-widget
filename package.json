{
  "name": "ai-usage-dock",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format:check": "prettier --check .",
    "build": "echo 'No frontend build step yet'",
    "rs:fmt": "cargo fmt --all",
    "rs:check": "cargo check",
    "rs:clippy": "cargo clippy --all-targets --all-features -- -D warnings",
    "rs:test": "cargo test"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "prettier": "^3.9.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0",
    "vitest": "^2.1.2"
  }
}
