{
  "name": "ai-usage-dock",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format:check": "prettier --check .",
    "build": "tsc && vite build",
    "rs:fmt": "cd src-tauri && cargo fmt --all",
    "rs:check": "cd src-tauri && cargo check",
    "rs:clippy": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "rs:test": "cd src-tauri && cargo test",
    "dev": "vite",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.12.0",
    "globals": "^15.11.0",
    "prettier": "^3.9.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.0.4",
    "vitest": "^2.1.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.9.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
